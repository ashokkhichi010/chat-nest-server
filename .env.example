# --- Server Configuration ---
PORT=4040
APP_URL=http://localhost:4040

# --- Database ---
# Replace with your MongoDB connection string
MONGODB_URL=mongodb://127.0.0.1:27017/chat-app

# --- Security & JWT ---
# Generate a strong random string for JWT_SECRET
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10

# --- Email (SMTP) ---
# Used for password reset and email verification
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USERNAME=null
SMTP_PASSWORD=null
EMAIL_FROM=noreply@chatapp.com

# --- External APIs (Trading) ---
# Integration with Angel Broking (SmartAPI)
SMARTAPI_BASE_URL=https://apiconnect.angelbroking.com/rest/secure/angelbroking
SMARTAPI_KEY=your_smartapi_key
SMARTAPI_SECRET=your_smartapi_secret
SMARTAPI_CLIENT_ID=your_client_id
SMARTAPI_PASSWORD=your_password
SMARTAPI_TOTP=0000
